# ===== 高德地图 API Key (必需) =====
# 使用「Web服务」类型的 Key（用于服务端 REST API 调用）
AMAP_API_KEY=your_amap_api_key

# ===== LLM 配置 (必需) =====
# 兼容 OpenAI / DeepSeek / 豆包等 OpenAI 兼容接口
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4

# ===== Unsplash API (可选，用于景点图片) =====
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# ===== 服务器配置 =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# 运行环境: local / dev / staging / prod
# 非 local/dev/staging 环境会自动隐藏 /docs 与 /redoc
ENVIRONMENT=local

# ===== CORS 配置 =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ===== 性能与缓存 =====
# 高德地图 POI / 天气 / 地理编码结果的进程内缓存时长（秒），设为 0 可关闭
AMAP_CACHE_TTL=600
