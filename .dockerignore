# ---- 依赖与构建产物（镜像内会重新安装/构建）----
node_modules
frontend/node_modules
backend/node_modules
frontend/dist
.venv
backend/.venv

# ---- Python 缓存 ----
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# ---- 测试与本地数据（不进入生产镜像）----
backend/tests
backend/data
backend/runtime_settings.json

# ---- 密钥与环境文件 ----
.env
backend/.env
frontend/.env
frontend/.env.local
backend/.env.example
frontend/.env.example

# ---- 版本控制与编辑器 ----
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.workbuddy-ai

# ---- 文档 ----
*.md

# ---- 本地备份目录（合并过程中的临时产物）----
_backup*
