# 高德地图 JS API Key（Web端 JS API，非 Web 服务 Key）
# 注意：前端代码读取的是 VITE_AMAP_WEB_JS_KEY，旧代码/文档曾写作 VITE_AMAP_JS_KEY，
# 现两种命名均可识别（config/index.ts 已做兼容）。
VITE_AMAP_WEB_JS_KEY=your_amap_js_api_key

# API基础URL
# 留空（推荐）表示使用相对路径：开发环境由 Vite proxy 转发 /api，生产环境由 Nginx 反代。
# 仅当后端部署在其他域名时才需要填写绝对地址，例如 https://api.example.com
VITE_API_BASE_URL=
